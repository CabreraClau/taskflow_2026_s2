{
  "info": {
    "name": "TaskFlow · Clase 5 · Testing de APIs",
    "description": "Exploración manual previa a los tests de Supertest. Ejecutar en orden (Runner o `npx newman run`). Las carpetas H-01, H-02 y H-03 reproducen los hallazgos de docs/hallazgos-api.md; sus tests quedan en rojo mientras los bugs sigan abiertos.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "0 · Setup",
      "item": [
        {
          "name": "Registrar usuario A (owner)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/auth/register",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "register"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{emailA}}\",\n  \"password\": \"Password1\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.collectionVariables.set('emailA', `postman-a-${Date.now()}@test.com`);"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('201 con token y usuario', () => {",
                  "  pm.response.to.have.status(201);",
                  "  const b = pm.response.json();",
                  "  pm.expect(b.token).to.be.a('string');",
                  "  pm.expect(b.user.id).to.match(/^user-\\d+$/);",
                  "  pm.expect(b.user).to.not.have.property('passwordHash');",
                  "  pm.collectionVariables.set('token', b.token);",
                  "  pm.collectionVariables.set('userA', b.user.id);",
                  "});"
                ]
              }
            }
          ]
        },

{
  "name": "taskflow",
  "version": "1.0.0",
  "private": true,
  "description": "TaskFlow — gestor de tareas colaborativo. Proyecto del curso de Testing y Calidad de Software.",
  "scripts": {
    "dev": "concurrently -n api,web -c blue,green \"npm:dev:server\" \"npm:dev:client\"",
    "dev:server": "npm --prefix server run dev",
    "dev:client": "npm --prefix client run dev",
    "build": "npm --prefix server run build",
    "build:client": "npm --prefix client run build",
    "start": "npm --prefix server start",
    "db:setup": "npm --prefix server run db:setup",
    "db:reset": "npm --prefix server run db:reset",
    "test": "npm --prefix server test",
    "test:a11y": "playwright test a11y --project=chromium --reporter=list --output=.audit/playwright",
    "test:security": "node security/http-security-audit.cjs",
    "test:coverage": "npm --prefix server run test:coverage",
    "lint": "npm --prefix server run lint",
    "postinstall": "npm --prefix server install && npm --prefix client install"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@playwright/test": "1.65.0",
    "concurrently": "9.1.0"
  },
  "engines": {
    "node": ">=20"
  }
}
